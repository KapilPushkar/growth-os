# Copy to .env and adjust. Never commit .env.

# SQLite for local dev. For Postgres later, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/growth_os
DATABASE_URL=sqlite:///./growth_os.db

# Dev-only default (32+ bytes). Use a long random value anywhere else:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_EXPIRE_MINUTES=720

# AI providers (optional). With no key, the app uses built-in templates.
# Anthropic is used first if both keys are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
