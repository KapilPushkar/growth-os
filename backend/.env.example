# Copy to .env and adjust. Never commit .env.

# SQLite for local dev. For Postgres later, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/growth_os
DATABASE_URL=sqlite:///./growth_os.db

# Dev-only default. Use a long random value anywhere else.
JWT_SECRET=dev-only-change-me

# AI providers (optional for now)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
